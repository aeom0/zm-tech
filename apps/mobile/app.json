{
  "expo": {
    "name": "SalonPro",
    "slug": "salonpro-mobile",
    "version": "1.1.0",
    "icon": "./assets/splash-icon.png",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/ff07d991-dcd2-446c-9b5b-9d5809855619"
    },
    "orientation": "portrait",
    "scheme": "salonpro",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.salonpro.app"
    },
    "android": {
      "package": "com.salonpro.app",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "bundler": "metro",
      "build": {
        "babel": {
          "include": ["@expo/vector-icons"]
        }
      },
      "name": "SalonPro",
      "shortName": "SalonPro",
      "description": "Gestión de salones de belleza y centros de estética",
      "themeColor": "#6366f1",
      "backgroundColor": "#FFFFFF",
      "display": "standalone",
      "orientation": "any",
      "startUrl": ".",
      "scope": "/"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#111318",
          "dark": {
            "backgroundColor": "#111318",
            "image": "./assets/splash-icon.png"
          }
        }
      ],
      "expo-web-browser",
      "expo-notifications"
    ],
    "experiments": {
      "reactCompiler": true
    },
    "extra": {
      "expoFontTimeout": 20000,
      "eas": {
        "projectId": "ff07d991-dcd2-446c-9b5b-9d5809855619"
      }
    },
    "owner": "aeom0"
  }
}
