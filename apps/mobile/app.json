{
  "expo": {
    "name": "SalonPro",
    "slug": "salonpro-mobile",
    "version": "1.1.0",
    "icon": "./assets/icon.png",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/ff07d991-dcd2-446c-9b5b-9d5809855619"
    },
    "orientation": "portrait",
    "scheme": "salonpro",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.salonpro.app"
    },
    "android": {
      "package": "com.salonpro.app",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#111318"
      }
    },
    "web": {
      "output": "single",
      "bundler": "metro",
      "build": {
        "babel": {
          "include": [
            "@expo/vector-icons"
          ]
        }
      },
      "name": "SalonPro",
      "shortName": "SalonPro",
      "description": "Gestión de salones de belleza y centros de estética",
      "themeColor": "#6366f1",
      "backgroundColor": "#FFFFFF",
      "display": "standalone",
      "orientation": "any",
      "startUrl": ".",
      "scope": "/"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-logo.png",
          "imageWidth": 280,
          "resizeMode": "contain",
          "backgroundColor": "#111318",
          "dark": {
            "backgroundColor": "#111318",
            "image": "./assets/splash-logo.png"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "SalonPro usa tu galería para poner foto al personal en la agenda.",
          "cameraPermission": "SalonPro puede usar la cámara si quieres tomar la foto del personal."
        }
      ],
      "expo-web-browser",
      "expo-notifications",
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "2.1.20",
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0",
            "gradleProperties": {
              "org.gradle.jvmargs": "-Xmx6g -XX:MaxMetaspaceSize=2g -XX:+HeapDumpOnOutOfMemoryError -Dfile.encoding=UTF-8",
              "org.gradle.daemon": "true",
              "org.gradle.parallel": "false",
              "org.gradle.configureondemand": "false",
              "kotlin.daemon.jvm.options": "-Xmx4g -XX:MaxMetaspaceSize=1g"
            }
          }
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true
    },
    "extra": {
      "expoFontTimeout": 20000,
      "eas": {
        "projectId": "ff07d991-dcd2-446c-9b5b-9d5809855619"
      }
    },
    "owner": "aeom0"
  }
}
