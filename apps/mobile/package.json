{
  "name": "mobile",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "dev": "expo start --localhost",
    "start": "expo start",
    "start:localhost": "expo start --localhost",
    "start:tunnel": "expo start --tunnel",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build": "expo export",
    "build:dev:android": "NODE_OPTIONS=--no-deprecation eas build --profile development --platform android",
    "build:preview:android": "NODE_OPTIONS=--no-deprecation eas build --profile preview --platform android",
    "build:preview:ios": "NODE_OPTIONS=--no-deprecation eas build --profile preview --platform ios",
    "lint": "npx expo lint",
    "check:types": "tsc --noEmit"
  },
  "dependencies": {
    "@expo-google-fonts/nunito": "^0.4.2",
    "@expo-google-fonts/poppins": "^0.4.1",
    "@expo/vector-icons": "^15.0.2",
    "@geemastudio/shared-schema": "workspace:*",
    "@geemastudio/tenant-config": "workspace:*",

    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/slider": "^5.0.1",
    "@react-native-masked-view/masked-view": "^0.3.2",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
