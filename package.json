{
  "name": "zm-tech",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "dev": "turbo run dev --filter=landing --filter=geemastudio-web",
    "dev:landing": "pnpm --filter landing dev",
    "dev:web": "pnpm --filter geemastudio-web dev",
    "dev:mobile": "pnpm --filter geemastudio-mobile dev",
    "dev:odental": "turbo run dev --filter=odentalpro-web",
    "dev:odental:web": "pnpm --filter odentalpro-web dev",
    "dev:odental:mobile": "pnpm --filter odentalpro-mobile dev",
    "dev:repmax": "turbo run dev --filter=repmax-web",
    "dev:repmax:web": "pnpm --filter repmax-web dev",
    "dev:repmax:mobile": "pnpm --filter repmax-mobile dev",
    "dev:hub": "pnpm --filter hub dev",
    "build": "turbo run build",
    "build:landing": "pnpm --filter landing build",
    "build:web": "pnpm --filter geemastudio-web build",
    "build:odental": "turbo run build --filter=odentalpro-web --filter=@odentalpro/dental-schema",
    "build:repmax": "turbo run build --filter=repmax-web --filter=@repmax/repmax-schema",
    "build:hub": "turbo run build --filter=hub --filter=@zmtech/hub-schema",

    "lint": "turbo run lint",
    "check:types": "turbo run check:types typecheck",
    "format": "pnpm --filter landing format && pnpm --filter @zmtech/quote-engine format",
    "format:check": "pnpm --filter landing format:check && pnpm --filter @zmtech/quote-engine format:check",
    "format:landing": "pnpm --filter landing format",
    "db:push": "pnpm --filter geemastudio-server exec drizzle-kit push",
    "db:generate": "pnpm --filter geemastudio-server exec drizzle-kit generate",
    "db:studio": "pnpm --filter geemastudio-server exec drizzle-kit studio"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "drizzle-kit": "^0.31.4",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "turbo": "^2.5.4",
    "typescript": "~6.0.3"
  }
}
