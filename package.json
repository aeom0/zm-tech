{
  "name": "salonpro",
  "version": "1.0.0",
  "private": true,
  "packageManager": "yarn@4.12.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"yarn server:dev\" \"yarn mobile:dev\"",
    "server:dev": "yarn workspace server dev",
    "server:build": "yarn workspace server build",
    "web:dev": "yarn workspace web dev",
    "mobile:dev": "yarn workspace mobile dev",
    "build": "yarn workspace web run build",
    "web:build": "yarn workspace web run build",
    "mobile:build": "yarn workspace mobile run build",
    "mobile:build:dev": "yarn workspace mobile eas build --profile development --platform android --non-interactive",
    "vercel-build": "yarn web:build",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "node scripts/db/run-seeds.js",
    "lint": "yarn workspaces run lint --if-present",
    "lint:fix": "yarn workspace mobile run lint:fix",
    "check:types": "tsc --noEmit",
    "check:format": "prettier --check \"**/*.{js,ts,tsx,css,json}\"",
    "format": "prettier --write \"**/*.{js,ts,tsx,css,json}\""
  },
  "dependencies": {
    "@salonpro/shared-schema": "workspace:*",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.39.3",
    "expo-updates": "~29.0.16"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/pg": "^8.16.0",
    "concurrently": "^9.1.2",
    "drizzle-kit": "^0.31.4",
    "eslint": "9.39.1",
    "eslint-config-expo": "^55.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-prettier": "^5.5.5",
    "expo": "^54.0.33",
    "pg": "^8.18.0",
    "prettier": "3.6.2",
    "typescript": "~5.9.2"
  }
}
