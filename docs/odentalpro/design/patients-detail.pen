                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "oBxHK",
                  "name": "PatientIdentityText",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 3,
                  "children": [
                    {
                      "type": "text",
                      "id": "XiXLA",
                      "name": "PatientFullName",
                      "fill": "$odental-heading",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Marielba Rojas",
                      "fontFamily": "$odental-font-ui",
                      "fontSize": "$odental-fs-xl",
                      "fontWeight": "700"
                    },
                    {
                      "type": "text",
                      "id": "wC2HN",
                      "name": "PatientMeta",
                      "fill": "$odental-muted",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "32 años · C.I. 20.145.876",
                      "fontFamily": "$odental-font-ui",
                      "fontSize": "$odental-fs-sm",
                      "fontWeight": "normal"
                    }
                  ]
                }
              ]
            },
            {
              "type": "frame",
              "id": "lyZIL",
              "name": "ClinicalAlert",
              "context": "Alertas de odental_patients.clinical_flags. Siempre visible sobre el resto de la ficha, nunca colapsada. Icono mas texto para que no dependa del color.",
              "metadata": {
                "type": "display",
                "testId": "patient-clinical-alert"
              },
              "width": "fill_container",
              "fill": "$odental-danger-soft",
              "cornerRadius": "$odental-radius-md",
              "gap": "$odental-space-md",
              "padding": "$odental-space-md",
              "alignItems": "center",
              "children": [
                {
                  "type": "icon",
                  "id": "WnqW9",
                  "name": "ClinicalAlertIcon",
                  "width": 18,
                  "height": 18,
                  "icon": "triangle-alert",
                  "library": "lucide",
                  "fill": "$odental-danger-strong"
                },
                {
                  "type": "text",
                  "id": "EWlcJ",
                  "name": "ClinicalAlertCopy",
                  "fill": "$odental-danger-strong",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Alérgica a la penicilina · hipertensión controlada",
                  "lineHeight": 1.35,
                  "fontFamily": "$odental-font-ui",
                  "fontSize": "$odental-fs-sm",
                  "fontWeight": "600"
                }
              ]
            },
            {
              "type": "frame",
              "id": "p3Q8I",
              "name": "OdontogramSection",
