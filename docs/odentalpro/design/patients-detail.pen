{
  "version": "2.14",
  "children": [
    {
      "type": "frame",
      "id": "TAHcH",
      "x": 0,
      "y": 0,
      "name": "OdentalPro / Patients / 01 / Detail / Default / Mobile",
      "context": "Ficha del paciente. Se llega desde Agenda o desde la lista de Pacientes. Reune identidad, alertas clinicas, odontograma y historial. Escritura solo para roles owner y especialista.",
      "theme": {
        "mode": "light"
      },
      "clip": true,
      "width": 390,
      "fill": "$odental-canvas",
      "layout": "vertical",
      "children": [
        {
          "id": "Iw9We",
          "type": "ref",
          "ref": "T2dijw",
          "name": "PatientStatusBar",
          "width": "fill_container"
        },
        {
          "type": "frame",
          "id": "NUTVV",
          "name": "PatientWrapper",
          "width": "fill_container",
          "layout": "vertical",
          "gap": "$odental-space-2xl",
          "padding": [
            "$odental-space-sm",
            0,
            "$odental-space-2xl",
            0
          ],
          "children": [
            {
              "type": "frame",
              "id": "lihAf",
              "name": "PatientNavRow",
              "width": "fill_container",
              "justifyContent": "space_between",
              "alignItems": "center",
              "children": [
                {
                  "type": "frame",
                  "id": "yovlO",
                  "name": "BackAction",
                  "context": "Regresa al origen de la navegacion: Agenda o lista de Pacientes.",
                  "metadata": {
                    "type": "interactive",
                    "testId": "patient-back",
                    "aria": {
                      "role": "button",
                      "label": "Volver"
                    }
                  },
                  "width": 44,
                  "height": 44,
                  "fill": "$odental-surface",
                  "cornerRadius": "$odental-radius-md",
                  "stroke": "$odental-border",
                  "strokeWidth": 1,
                  "strokeAlignment": "inner",
                  "justifyContent": "center",
                  "alignItems": "center",
                  "children": [
                    {
                      "type": "icon",
                      "id": "ooHx3",
                      "name": "BackIcon",
                      "width": 20,
                      "height": 20,
                      "icon": "chevron-left",
                      "library": "lucide",
                      "fill": "$odental-text"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "gVSRq",
                  "name": "PatientNavActions",
                  "gap": "$odental-space-sm",
                  "alignItems": "center",
                  "children": [
                    {
                      "type": "frame",
                      "id": "yMwBO",
                      "name": "WhatsAppAction",
                      "context": "Abre la conversacion del bot WABA con la plantilla de recordatorio precargada.",
                      "metadata": {
                        "type": "interactive",
                        "testId": "patient-whatsapp",
                        "analytics": {
                          "event": "patient.whatsapp_open"
                        },
                        "aria": {
                          "role": "button",
                          "label": "Escribir por WhatsApp"
                        }
                      },
                      "width": 44,
                      "height": 44,
                      "fill": "$odental-primary-soft",
                      "cornerRadius": "$odental-radius-md",
                      "justifyContent": "center",
                      "alignItems": "center",
                      "children": [
                        {
                          "type": "icon",
                          "id": "y0mwj",
                          "name": "WhatsAppIcon",
                          "width": 20,
                          "height": 20,
                          "icon": "message-circle",
                          "library": "lucide",
                          "fill": "$odental-primary-dark"
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "C5rXVg",
                      "name": "PatientMoreAction",
                      "context": "Editar datos, exportar historia en PDF, dar de baja al paciente.",
                      "metadata": {
                        "type": "interactive",
                        "testId": "patient-more",
                        "aria": {
                          "role": "button",
                          "label": "Mas opciones"
                        }
                      },
                      "width": 44,
                      "height": 44,
                      "fill": "$odental-surface",
                      "cornerRadius": "$odental-radius-md",
                      "stroke": "$odental-border",
                      "strokeWidth": 1,
                      "strokeAlignment": "inner",
                      "justifyContent": "center",
                      "alignItems": "center",
                      "children": [
                        {
                          "type": "icon",
                          "id": "IpuwZ",
                          "name": "PatientMoreIcon",
                          "width": 20,
                          "height": 20,
                          "icon": "ellipsis-vertical",
                          "library": "lucide",
                          "fill": "$odental-text"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "frame",
              "id": "SyGBj",
              "name": "PatientIdentity",
              "width": "fill_container",
              "gap": "$odental-space-lg",
              "alignItems": "center",
              "children": [
                {
                  "type": "frame",
                  "id": "dn01z",
                  "name": "PatientAvatar",
                  "context": "Iniciales cuando el paciente no tiene foto cargada en Storage.",
                  "width": 62,
                  "height": 62,
                  "fill": "$odental-aqua-100",
                  "cornerRadius": "$odental-radius-xl",
                  "justifyContent": "center",
                  "alignItems": "center",
                  "children": [
                    {
                      "type": "text",
                      "id": "p203Y",
                      "name": "PatientInitials",
                      "fill": "$odental-aqua-600",
