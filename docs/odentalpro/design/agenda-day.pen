    {
      "type": "frame",
      "id": "JwEIV",
      "x": 1545,
      "y": 70,
      "name": "OdentalPro / Agenda / 01 / Day / Default / Mobile",
      "context": "Pantalla principal del dia. Viene del selector de consultorio y va al detalle de cita o a la ficha del paciente. Datos de odental_appointments filtrados por tenant_id y fecha en la zona horaria del consultorio.",
      "clip": true,
      "width": 390,
      "fill": "$odental-canvas",
      "layout": "vertical",
      "children": [
        {
          "id": "QzZpr",
          "type": "ref",
          "ref": "T2dijw",
          "name": "AgendaStatusBar",
          "width": "fill_container"
