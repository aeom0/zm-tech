    {
      "type": "frame",
      "id": "e9q9nq",
      "x": 0,
      "y": 480,
      "name": "ButtonPrimary",
      "context": "Accion primaria. Hover oscurece a primary-dark, focus agrega anillo de 2px en $odental-focus, disabled baja opacidad a 0.45 y bloquea el tap. Instancias sin icono ponen ButtonIcon enabled:false.",
      "reusable": true,
      "metadata": {
        "type": "interactive",
        "testId": "button-primary",
        "aria": {
          "role": "button"
        }
      },
      "width": 358,
      "height": 52,
      "fill": "$odental-primary",
      "cornerRadius": "$odental-radius-lg",
      "gap": "$odental-space-sm",
      "padding": [
        0,
        "$odental-space-xl"
      ],
      "justifyContent": "center",
      "alignItems": "center",
      "children": [
        {
          "type": "text",
          "id": "FrnFR",
          "name": "ButtonLabel",
          "fill": "$odental-on-primary",
          "content": "Entrar",
          "fontFamily": "$odental-font-ui",
          "fontSize": "$odental-fs-base",
          "fontWeight": "600"
        },
        {
          "type": "icon",
          "id": "QVKUM",
          "name": "ButtonIcon",
          "opacity": 0.8,
          "width": 18,
          "height": 18,
          "icon": "arrow-right",
          "library": "lucide",
          "fill": "$odental-on-primary"
        }
      ]
    },
    {
      "type": "frame",
      "id": "TYsak",
      "x": 400,
      "y": 480,
      "name": "InputField",
      "context": "Campo de texto. Validacion al perder el foco, nunca mientras se escribe. El error se muestra con borde danger mas icono y texto bajo el campo.",
      "reusable": true,
      "metadata": {
        "type": "interactive",
        "testId": "input-field",
        "validation": {
          "required": true,
          "errorCopy": {
            "required": "Completa este campo",
            "format": "Revisa el formato",
            "mismatch": "Los datos no coinciden"
          }
        }
      },
      "width": 358,
      "layout": "vertical",
      "gap": "$odental-space-sm",
      "children": [
        {
          "type": "text",
          "id": "i9UUHB",
