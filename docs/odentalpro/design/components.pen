{
  "version": "2.14",
  "children": [
    {
      "type": "frame",
      "id": "T2dijw",
      "x": 0,
      "y": 0,
      "name": "StatusBar",
      "context": "OS chrome mock para las pantallas mobile. Instancias sobreescriben width a fill_container. No colocar UI de la app detras.",
      "reusable": true,
      "width": 390,
      "height": 62,
      "fill": "$odental-canvas",
      "padding": [
        0,
        "$odental-space-xl"
      ],
      "justifyContent": "space_between",
      "alignItems": "center",
      "children": [
        {
          "type": "text",
          "id": "ihqSj",
          "name": "StatusTime",
          "fill": "$odental-text",
          "content": "9:41",
          "fontFamily": "$odental-font-ui",
          "fontSize": "$odental-fs-sm",
          "fontWeight": "600"
        },
        {
          "type": "frame",
          "id": "L6zOWu",
          "name": "StatusIndicators",
          "gap": "$odental-space-xs",
          "alignItems": "center",
          "children": [
            {
              "type": "icon",
              "id": "Lr14A",
              "name": "SignalIndicator",
              "width": 15,
              "height": 15,
              "icon": "signal-high",
              "library": "lucide",
              "fill": "$odental-text"
            },
            {
              "type": "icon",
              "id": "HCMhB",
              "name": "WifiIndicator",
              "width": 15,
              "height": 15,
              "icon": "wifi",
              "library": "lucide",
              "fill": "$odental-text"
            },
            {
              "type": "icon",
              "id": "Wo82p",
              "name": "BatteryIndicator",
              "width": 18,
              "height": 18,
              "icon": "battery-full",
              "library": "lucide",
              "fill": "$odental-text"
            }
          ]
        }
      ]
    },
    {
      "type": "frame",
      "id": "FWcYR",
      "x": 430,
      "y": 0,
      "name": "TabBar",
      "context": "Dock de navegacion principal, 4 destinos. Ultimo item del stack vertical de cada pantalla, nunca posicionado en absoluto. El item activo se marca con capsula suave mas icono y label en primary.",
      "reusable": true,
      "width": 390,
      "layout": "vertical",
      "padding": [
        0,
        "$odental-space-lg",
        "$odental-space-md",
        "$odental-space-lg"
      ],
      "children": [
        {
          "type": "frame",
          "id": "N6SDr4",
          "name": "TabBarCapsule",
          "width": "fill_container",
          "height": 56,
          "fill": "$odental-glass",
          "cornerRadius": 28,
          "stroke": "$odental-border",
          "strokeWidth": 1,
          "strokeAlignment": "inner",
          "effect": [
            {
              "type": "shadow",
              "shadowType": "outer",
              "color": "$odental-shadow-ambient",
              "offset": {
                "x": 0,
                "y": 1
              },
              "blur": 2
            },
            {
              "type": "shadow",
              "shadowType": "outer",
              "color": "$odental-shadow-direct",
              "offset": {
                "x": 0,
                "y": 4
              },
              "blur": 12
            }
          ],
          "padding": 6,
          "alignItems": "center",
          "children": [
            {
              "type": "frame",
              "id": "koZY6",
              "name": "TabItemHome",
              "context": "Destino Inicio. Estado inactivo por defecto.",
              "metadata": {
                "type": "interactive",
                "testId": "tab-home",
                "analytics": {
                  "event": "nav.tab_select",
                  "props": {
                    "tab": "inicio"
                  }
                },
                "aria": {
                  "role": "tab",
                  "label": "Inicio"
                }
              },
              "width": "fill_container",
              "height": "fill_container",
              "cornerRadius": 22,
              "layout": "vertical",
              "gap": 2,
              "justifyContent": "center",
              "alignItems": "center",
              "children": [
                {
                  "type": "icon",
                  "id": "yxOa7",
                  "name": "TabIconHome",
                  "width": 22,
                  "height": 22,
                  "icon": "house",
                  "library": "lucide",
                  "fill": "$odental-muted"
                },
                {
                  "type": "text",
                  "id": "Q6Fp4",
                  "name": "TabLabelHome",
                  "fill": "$odental-muted",
                  "content": "Inicio",
                  "fontFamily": "$odental-font-ui",
                  "fontSize": 10,
                  "fontWeight": "500"
                }
              ]
            },
            {
              "type": "frame",
              "id": "B6Jow",
              "name": "TabItemAgenda",
              "context": "Destino Agenda. Estado activo: capsula primary-soft mas icono y label en primary-dark.",
              "metadata": {
                "type": "interactive",
                "testId": "tab-agenda",
                "analytics": {
                  "event": "nav.tab_select",
                  "props": {
                    "tab": "agenda"
                  }
                },
                "aria": {
                  "role": "tab",
                  "label": "Agenda"
                }
              },
              "width": "fill_container",
              "height": "fill_container",
              "fill": "$odental-primary-soft",
              "cornerRadius": 22,
              "layout": "vertical",
              "gap": 2,
              "justifyContent": "center",
              "alignItems": "center",
              "children": [
                {
                  "type": "icon",
                  "id": "ZzVUR",
                  "name": "TabIconAgenda",
                  "width": 22,
                  "height": 22,
                  "icon": "calendar-days",
