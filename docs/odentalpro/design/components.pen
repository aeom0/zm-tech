    },
    {
      "type": "frame",
      "id": "zBia3",
      "x": 430,
      "y": 120,
      "name": "StatusPill",
      "context": "Estado de una cita o tratamiento. El color nunca va solo: siempre acompanado de icono y texto para lectura sin color.",
