          "fontSize": "$odental-fs-base",
          "fontWeight": "600"
        },
        {
          "type": "icon",
          "id": "QVKUM",
          "name": "ButtonIcon",
          "opacity": 0.8,
          "width": 18,
          "height": 18,
          "icon": "arrow-right",
          "library": "lucide",
          "fill": "$odental-on-primary"
