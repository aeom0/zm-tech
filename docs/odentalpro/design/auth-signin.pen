                {
                  "type": "text",
                  "id": "G2wgq",
                  "name": "SecurityCopy",
                  "fill": "$odental-muted",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Las historias clínicas viajan cifradas y solo las ve el personal autorizado de tu consultorio.",
                  "lineHeight": 1.5,
                  "fontFamily": "$odental-font-ui",
                  "fontSize": "$odental-fs-xs",
                  "fontWeight": "normal"
                }
              ]
            }
          ]
