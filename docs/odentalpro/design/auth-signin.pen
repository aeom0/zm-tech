                            {
                              "type": "icon",
                              "id": "SV4MI",
                              "name": "RememberCheck",
                              "width": 13,
                              "height": 13,
                              "icon": "check",
                              "library": "lucide",
                              "fill": "$odental-on-primary"
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "id": "qPxVi",
                          "name": "RememberLabel",
                          "fill": "$odental-muted",
                          "content": "Mantener sesión",
                          "fontFamily": "$odental-font-ui",
                          "fontSize": "$odental-fs-sm",
                          "fontWeight": "normal"
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "P4IM9Y",
                      "name": "ForgotPasswordLink",
                      "context": "Abre el flujo de recuperacion por correo. No revela si la cuenta existe.",
                      "metadata": {
                        "type": "interactive",
                        "testId": "signin-forgot",
                        "analytics": {
                          "event": "auth.password_reset_start"
                        },
                        "aria": {
                          "role": "link"
                        }
                      },
                      "height": 44,
                      "alignItems": "center",
                      "children": [
                        {
                          "type": "text",
                          "id": "ulEAF",
                          "name": "ForgotLabel",
                          "fill": "$odental-primary-dark",
                          "content": "Olvidé mi clave",
                          "fontFamily": "$odental-font-ui",
                          "fontSize": "$odental-fs-sm",
                          "fontWeight": "600"
                        }
                      ]
                    }
                  ]
                }
