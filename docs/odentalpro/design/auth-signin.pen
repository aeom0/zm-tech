{
  "version": "2.14",
  "children": [
    {
      "type": "frame",
      "id": "lshr3",
      "x": 0,
      "y": 0,
      "name": "OdentalPro / Auth / 01 / SignIn / Default / Mobile",
      "context": "Entrada al producto. Viene de la landing publica y va al selector de consultorio y luego a Agenda. Sesion con Supabase Auth, correo mas clave. Si la sesion expira se vuelve aca con el correo precargado.",
      "clip": true,
      "width": 390,
      "fill": "$odental-canvas",
      "layout": "vertical",
      "children": [
        {
          "id": "M8V39G",
          "type": "ref",
          "ref": "T2dijw",
          "name": "SignInStatusBar",
          "width": "fill_container"
        },
        {
          "type": "frame",
          "id": "Shpbh",
          "name": "SignInWrapper",
          "width": "fill_container",
          "layout": "vertical",
          "gap": "$odental-space-3xl",
          "padding": [
            "$odental-space-sm",
            "$odental-space-xl",
            "$odental-space-3xl",
            "$odental-space-xl"
          ],
          "children": [
            {
              "type": "frame",
              "id": "IG3i2",
              "name": "BrandLock",
              "width": "fill_container",
              "layout": "vertical",
              "gap": "$odental-space-md",
              "children": [
                {
                  "type": "frame",
                  "id": "a36fBW",
                  "name": "LogoMark",
                  "width": 56,
                  "height": 56,
                  "fill": "$odental-primary-soft",
                  "cornerRadius": "$odental-radius-lg",
                  "justifyContent": "center",
                  "alignItems": "center",
                  "children": [
                    {
                      "type": "icon",
                      "id": "K8eQif",
                      "name": "LogoGlyph",
                      "width": 30,
                      "height": 30,
                      "icon": "dentistry",
                      "library": "Material Symbols Rounded",
                      "fill": "$odental-primary-dark"
                    }
                  ]
                },
                {
                  "type": "text",
                  "id": "iWyEp",
                  "name": "SignInTitle",
                  "fill": "$odental-heading",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Entra a tu consultorio",
                  "lineHeight": 1.15,
                  "fontFamily": "$odental-font-ui",
                  "fontSize": "$odental-fs-2xl",
                  "fontWeight": "700"
                },
                {
                  "type": "text",
                  "id": "cORot",
                  "name": "SignInSubtitle",
                  "fill": "$odental-muted",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Agenda, historias clínicas y planes de tratamiento en un solo lugar.",
                  "lineHeight": 1.45,
                  "fontFamily": "$odental-font-ui",
                  "fontSize": "$odental-fs-base",
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "LlRX2",
              "name": "CredentialsForm",
              "context": "Validacion al perder el foco. El submit se bloquea mientras corre la peticion y muestra el estado cargando en el boton.",
              "width": "fill_container",
              "layout": "vertical",
              "gap": "$odental-space-xl",
              "children": [
                {
                  "id": "Tk0mZ",
                  "type": "ref",
                  "ref": "TYsak",
                  "name": "EmailField",
                  "width": "fill_container",
                  "descendants": {
                    "i9UUHB": {
                      "content": "Correo"
                    },
                    "qqX78": {
                      "icon": "mail"
                    },
                    "OGdoY": {
                      "content": "marielba.rojas@correo.com"
                    }
                  }
                },
                {
                  "id": "d6YobT",
                  "type": "ref",
                  "ref": "TYsak",
                  "name": "PasswordField",
                  "width": "fill_container",
                  "descendants": {
                    "i9UUHB": {
                      "content": "Clave"
                    },
                    "qqX78": {
                      "icon": "lock"
                    },
                    "OGdoY": {
                      "content": "••••••••••",
                      "letterSpacing": 3
                    }
                  }
                },
                {
                  "type": "frame",
                  "id": "JOnzz",
                  "name": "FormMetaRow",
                  "width": "fill_container",
                  "justifyContent": "space_between",
                  "alignItems": "center",
                  "children": [
                    {
                      "type": "frame",
                      "id": "pCyX8",
                      "name": "RememberSession",
                      "context": "Marcado por defecto en dispositivos del consultorio. Extiende el refresh token a 30 dias.",
                      "metadata": {
                        "type": "interactive",
                        "testId": "signin-remember",
                        "aria": {
                          "role": "checkbox",
                          "label": "Mantener sesion abierta"
                        }
                      },
                      "height": 44,
                      "gap": "$odental-space-sm",
                      "alignItems": "center",
                      "children": [
                        {
                          "type": "frame",
                          "id": "WdL10",
                          "name": "RememberCheckbox",
                          "width": 20,
                          "height": 20,
                          "fill": "$odental-primary",
                          "cornerRadius": 6,
                          "justifyContent": "center",
                          "alignItems": "center",
