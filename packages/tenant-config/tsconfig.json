{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "jsx": "react-jsx",
    "rootDir": "./src",
    "outDir": "dist",
    "esModuleInterop": true,
    "types": ["react"]
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
