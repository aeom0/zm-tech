# IMPORTANTE: si existe .easignore, EAS IGNORA .gitignore.
# Este archivo debe incluir todo lo de .gitignore + exclusiones extra.

# --- espejo de .gitignore ---
node_modules/
.pnp
.pnp.*
.pnpm-store/
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.turbo/
coverage/
.next/
out/
.expo/
web-build/
expo-env.d.ts
.metro-health-check*
.kotlin/
apps/geemastudio-mobile/android/
apps/geemastudio-mobile/ios/
apps/geemastudio-mobile/*.apk
apps/repmax-mobile/android/
apps/repmax-mobile/ios/
apps/odentalpro-mobile/android/
apps/odentalpro-mobile/ios/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
build/
dist/
.DS_Store
*.pem
__pycache__/
*.pyc
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
pnpm-debug.log*
.env
.env.*
!.env.example
!**/.env.example
.vercel
*.tsbuildinfo
next-env.d.ts
**/supabase/.temp/
.claude/*
!.claude/skills
.mcp.json
.cursor/mcp.json
**/.cursor/mcp.json
**/google-services.json
**/GoogleService-Info.plist

# --- extra EAS (no hace falta en el builder) ---
.cursor/
docs/
**/*.md
!README.md
!apps/repmax-mobile/README.md
