# Copiar a .env y completar valores: cp .env.example .env

# --- Supabase (mobile Expo) ---
# URL del proyecto: https://xxx.supabase.co
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (scripts servidor: seed-auth-users) ---
# Igual que EXPO_PUBLIC_SUPABASE_URL
SUPABASE_URL=
# Dashboard → Settings → API → service_role (solo para scripts, nunca en cliente)
SUPABASE_SERVICE_ROLE_KEY=

# --- Base de datos PostgreSQL (Drizzle migrations + seeds) ---
# Supabase: postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
DATABASE_URL=

# --- Seeds ---
# Contraseña inicial para usuarios creados por seed-auth-users.mjs
SEED_AUTH_PASSWORD=SalonPro2025!

# Web (apps/web): copiar a apps/web/.env.local como:
#   NEXT_PUBLIC_SUPABASE_URL=<mismo valor que EXPO_PUBLIC_SUPABASE_URL>
#   NEXT_PUBLIC_SUPABASE_ANON_KEY=<mismo valor que EXPO_PUBLIC_SUPABASE_ANON_KEY>
