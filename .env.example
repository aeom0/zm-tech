# Copiar a .env y completar valores: cp .env.example .env

# Base de datos PostgreSQL (requerido)
# Ejemplo local: postgresql://usuario:clave@localhost:5432/zm_lash_nails
# Ejemplo cloud: postgresql://user:pass@host:5432/dbname?sslmode=require
DATABASE_URL=

# Puerto del backend Express (por defecto 5000)
PORT=5000

# --- Supabase (mobile + web + script de usuarios) ---
# URL del proyecto: https://xxx.supabase.co
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Web (apps/web): copiar a apps/web/.env.local como NEXT_PUBLIC_SUPABASE_URL y NEXT_PUBLIC_SUPABASE_ANON_KEY
# Solo para script seed-auth-users (crear usuarios una vez). Dashboard → Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=
# Opcional: contraseña inicial al crear usuarios (default: Zmlash2025!)
# SEED_AUTH_PASSWORD=Zmlash2025!

# --- Desarrollo local ---
# URL completa del API para el cliente (Expo). Usar en local con backend en 5000.
EXPO_PUBLIC_API_URL=http://localhost:5000

# --- Solo Replit / despliegue (opcional) ---
# REPLIT_DEV_DOMAIN=  (Replit lo inyecta en dev)
# REPLIT_DOMAINS=     (Replit lo inyecta en prod)
# EXPO_PUBLIC_DOMAIN= (host:puerto para cliente en Replit, ej. tu-repl.replit.dev:5000)

# --- WhatsApp Business API ---
# Token de verificación para el webhook (tú lo defines, puede ser cualquier string seguro)
WHATSAPP_VERIFY_TOKEN=tu_token_de_verificacion_aqui

# Token de acceso de la API de WhatsApp (desde Meta Business Suite)
WHATSAPP_ACCESS_TOKEN=

# ID del número de teléfono de WhatsApp Business
WHATSAPP_PHONE_NUMBER_ID=

# ID de la cuenta de WhatsApp Business
WHATSAPP_BUSINESS_ACCOUNT_ID=
